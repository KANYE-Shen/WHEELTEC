  <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 6 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 6 0.1</size></box></geometry><material><ambient>0.85 0.82 0.72 1</ambient><diffuse>0.85 0.82 0.72 1</diffuse></material></visual></link></model>
