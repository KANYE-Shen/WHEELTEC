<?xml version="1.0"?>
<sdf version="1.8">
<model name="wheeltec_reference">
  <link name="base_link">
    <inertial><pose>0 0 0.12 0 0 0</pose><mass>5</mass><inertia><ixx>0.0387</ixx><iyy>0.06</iyy><izz>0.0867</izz></inertia></inertial>
    <collision name="body"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.36 0.28 0.12</size></box></geometry></collision>
    <visual name="body"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.36 0.28 0.12</size></box></geometry><material><ambient>0.05 0.35 0.8 1</ambient><diffuse>0.05 0.35 0.8 1</diffuse></material></visual>
    <visual name="front"><pose>0.17 0 0.19 0 0 0</pose><geometry><box><size>0.03 0.15 0.02</size></box></geometry><material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
    <visual name="laser_body"><pose>0 0 0.21 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    <sensor name="laser" type="gpu_lidar">
      <pose>0 0 0.25 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize>
      <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal><vertical><samples>3</samples><resolution>1</resolution><min_angle>-0.01</min_angle><max_angle>0.01</max_angle></vertical></scan><range><min>0.08</min><max>10</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </link>
  <link name="left_wheel"><pose>0 0.175 0.075 0 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.00062</ixx><iyy>0.001125</iyy><izz>0.00062</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link><joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
  <link name="right_wheel"><pose>0 -0.175 0.075 0 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.00062</ixx><iyy>0.001125</iyy><izz>0.00062</izz></inertia></inertial><collision name="collision"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="visual"><pose>0 0 0 1.57079632679 0 0</pose><geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link><joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
  <link name="front_caster"><pose>0.14 0 0.03 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.000018</ixx><iyy>0.000018</iyy><izz>0.000018</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.03</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.03</radius></sphere></geometry></visual></link><joint name="front_caster_joint" type="fixed"><parent>base_link</parent><child>front_caster</child></joint>
  <link name="rear_caster"><pose>-0.14 0 0.03 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.000018</ixx><iyy>0.000018</iyy><izz>0.000018</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.03</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.03</radius></sphere></geometry></visual></link><joint name="rear_caster_joint" type="fixed"><parent>base_link</parent><child>rear_caster</child></joint>
  <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.35</wheel_separation><wheel_radius>0.075</wheel_radius><odom_publish_frequency>30</odom_publish_frequency>
    <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    <max_linear_velocity>0.3</max_linear_velocity><min_linear_velocity>-0.3</min_linear_velocity><max_angular_velocity>1.0</max_angular_velocity><min_angular_velocity>-1.0</min_angular_velocity>
    <max_linear_acceleration>0.4</max_linear_acceleration><min_linear_acceleration>-0.4</min_linear_acceleration><max_angular_acceleration>1.5</max_angular_acceleration><min_angular_acceleration>-1.5</min_angular_acceleration>
  </plugin>
</model>
</sdf>
